[Unit]
Description=SmartConnect — WireGuard to VLESS Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=%i
ExecStart=/usr/local/bin/smartconnect connect
ExecStop=/usr/local/bin/smartconnect disconnect
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
